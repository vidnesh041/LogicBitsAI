# LogicBitsAI Backend Environment Variables Example
# Set these in your Render Dashboard environment settings for Production

# Port for Uvicorn server (automatically provided by Render)
PORT=8000

# CORS Allowed Origin for Vercel Frontend
ALLOWED_ORIGIN=https://your-vercel-frontend-domain.vercel.app

# Primary AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=your_grok_xai_api_key_here

# Firebase Service Account (base64 encoded JSON string)
FIREBASE_SERVICE_ACCOUNT_JSON=your_base64_encoded_service_account_json_here
